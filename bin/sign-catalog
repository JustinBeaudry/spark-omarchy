#!/usr/bin/env python3
"""Maintainer-only local signing. The private key must remain outside the repo."""
import argparse
import base64
from datetime import datetime, timedelta, timezone
import json
from pathlib import Path
import sys
import tempfile
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from spark_omarchy.common import Error, ROOT, atomic_write, executable, run
from spark_omarchy.releases import validate_catalog, verify_envelope


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--key', required=True, type=Path)
    parser.add_argument('--sequence', required=True, type=int)
    parser.add_argument('--days', type=int, default=90)
    parser.add_argument('--catalog', type=Path, default=ROOT / 'updates/catalog.json')
    parser.add_argument('--output', type=Path, default=ROOT / 'updates/stable.json')
    args = parser.parse_args()
    try:
        key = args.key.expanduser().resolve()
        if key.is_relative_to(ROOT) or key.stat().st_mode & 0o077:
            raise Error('Private key must be outside the checkout and have owner-only permissions.')
        if not 1 <= args.days <= 120:
            raise Error('Catalog validity must be between 1 and 120 days.')
        if args.output.exists():
            previous = json.loads(base64.b64decode(json.loads(args.output.read_text())['payload']))
            if args.sequence <= previous['sequence']:
                raise Error('Sequence must increase beyond the existing published envelope.')
        catalog = json.loads(args.catalog.read_text())
        now = datetime.now(timezone.utc)
        catalog.update(sequence=args.sequence, issued_at=now.strftime('%Y-%m-%dT%H:%M:%SZ'),
                       expires_at=(now + timedelta(days=args.days)).strftime('%Y-%m-%dT%H:%M:%SZ'))
        validate_catalog(catalog, now)
        payload = json.dumps(catalog, sort_keys=True, separators=(',', ':')).encode()
        with tempfile.TemporaryDirectory(prefix='spark-sign-') as temporary:
            root = Path(temporary)
            (root / 'payload').write_bytes(payload)
            run([executable('openssl'), 'pkeyutl', '-sign', '-rawin', '-inkey', key,
                 '-in', root / 'payload', '-out', root / 'signature'])
            signature = (root / 'signature').read_bytes()
        if len(signature) != 64:
            raise Error('Expected an Ed25519 signature (64 bytes).')
        envelope = {'schema': 1, 'payload': base64.b64encode(payload).decode(),
                    'signature': base64.b64encode(signature).decode()}
        encoded = (json.dumps(envelope, indent=2) + '\n').encode()
        verify_envelope(encoded, now=now)  # Reject the wrong maintainer key before publishing.
        atomic_write(args.output, encoded.decode(), 0o644)
        print(f'Signed stable catalog sequence {args.sequence}; expires {catalog["expires_at"]}.')
        return 0
    except (Error, OSError, ValueError, KeyError) as exc:
        print('sign-catalog: ' + str(exc), file=sys.stderr)
        return 1


sys.exit(main())
